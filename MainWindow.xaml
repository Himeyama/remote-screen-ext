<Window
    x:Class="RemoteScreen.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Remote Screen">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>
    <Grid RowDefinitions="Auto,*,Auto">
        <TitleBar x:Name="AppTitleBar" />
        <ScrollViewer Grid.Row="1" Padding="24,16,24,24">
            <StackPanel Spacing="24">
                <StackPanel Spacing="8">
                    <TextBlock Text="投影する画面" Style="{ThemeResource SubtitleTextBlockStyle}" />
                    <RadioButtons x:Name="ModePicker" AutomationProperties.Name="投影モード"
                                  MaxColumns="2" SelectedIndex="0" SelectionChanged="ModeChanged">
                        <RadioButton Content="複製" />
                        <RadioButton Content="拡張" />
                    </RadioButtons>
                    <TextBlock x:Name="ModeHint" TextWrapping="Wrap"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                    <ComboBox x:Name="DisplayPicker" x:Uid="DisplayPicker" MinWidth="240"
                              DisplayMemberPath="Label" SelectionChanged="DisplayChanged"
                              AutomationProperties.AutomationId="SharedDisplay" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="DisplaySettingsButton" Content="Windows のディスプレイ設定" Click="OpenDisplaySettings" />
                        <Button x:Name="RefreshButton" Content="一覧を更新" Click="RefreshDisplays" />
                    </StackPanel>
                    <StackPanel x:Name="DisplayActions" Visibility="Collapsed" Spacing="8">
                        <Button x:Name="InstallDriverButton" x:Uid="InstallDriverButton"
                                Click="OpenDriverSetup" AutomationProperties.AutomationId="InstallDriver" />
                        <HyperlinkButton x:Name="DriverDownloadLink" Content="仮想ディスプレイドライバーの入手先"
                                         NavigateUri="https://github.com/VirtualDrivers/Virtual-Display-Driver" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="StartButton" Content="共有を開始" Click="StartSharing"
                                Style="{StaticResource AccentButtonStyle}" />
                        <Button x:Name="StopButton" Content="共有を停止" Click="StopSharing" IsEnabled="False" />
                    </StackPanel>
                </StackPanel>
                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="10">
                        <TextBlock Text="ブラウザの接続先" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        <TextBlock x:Name="ConnectionHint" TextWrapping="Wrap" />
                        <ComboBox x:Name="AddressPicker" Header="接続アドレス" Visibility="Collapsed"
                                  MinWidth="200" SelectionChanged="AddressChanged" />
                        <TextBox x:Name="ConnectionLink" Header="共有リンク" IsReadOnly="True" Visibility="Collapsed" />
                        <TextBox x:Name="ConnectionCode" Header="認証コード" IsReadOnly="True" Visibility="Collapsed" />
                        <StackPanel x:Name="ConnectionActions" Orientation="Horizontal" Spacing="8" Visibility="Collapsed">
                            <Button Content="リンクをコピー" Click="CopyLink" />
                            <Button Content="この PC で開く" Click="OpenViewer" />
                        </StackPanel>
                        <Button x:Name="ClearDevicesButton" x:Uid="ClearDevicesButton"
                                Click="ClearDevices" AutomationProperties.AutomationId="ClearDevices" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" Padding="12,4,24,4"
                BorderThickness="0,1,0,0" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}">
            <TextBlock x:Name="SharingStatus" Style="{ThemeResource CaptionTextBlockStyle}"
                       TextWrapping="NoWrap" MaxLines="1" TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite" />
        </Border>
    </Grid>
</Window>
